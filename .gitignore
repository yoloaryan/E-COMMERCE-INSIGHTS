# Virtual Environment
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Data files (keep raw & heavy CSV data out of git, include compact processed parquet)
data/raw/*
!data/raw/.gitkeep
data/processed/*.csv
data/state/*.db*
!data/state/.gitkeep

# Models & Artifacts (tracked for containerized cloud deployment)
# models/*.joblib and models/*.pkl are tracked
!models/.gitkeep

# OS & IDE
.DS_Store
.vscode/
.idea/
*.log
.env
