# Production Container for Prism Retail - FastAPI ML Serving Layer
FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install minimal OS build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Create non-root system user for security hardening
RUN useradd -m -u 10001 -s /bin/bash appuser

# Copy source code, model binaries, and processed datasets
COPY src/ /app/src/
COPY models/ /app/models/
COPY data/processed/ /app/data/processed/

# Set up runtime directories and ownership
RUN mkdir -p /app/data/raw/imported_batches && \
    chown -R appuser:appuser /app

# Switch to non-root execution
USER appuser

# Expose FastAPI HTTP port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "src.api.server:app", "--host", "0.0.0.0", "--port", "8000"]


